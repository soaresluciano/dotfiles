#!/usr/bin/env bash
set -euo pipefail

# Browse installed packages interactively in fzf with repo/AUR check, colors, and pacman -Qi preview
# Usage: pacbrowse [all|explicit|orphans|foreign|issues]
mode="${1:-all}"

build_entries() {
  case "$mode" in
    explicit|list)
      pacman -Qet | awk '
        ARGIND == 1 { repo[$2] = $1; next }
        {
          r = ($1 in repo) ? repo[$1] : "foreign"
          printf "\033[0;32m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;36m[%s]\033[0m\texplicit\t%s\n", $1, $2, r, r
        }
      ' <(pacman -Sl || true) -
      ;;
    orphans)
      pacman -Qdt | awk '
        ARGIND == 1 { repo[$2] = $1; next }
        {
          r = ($1 in repo) ? repo[$1] : "foreign"
          printf "\033[0;33m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;33m[%s]\033[0m\torphan\t%s\n", $1, $2, r, r
        }
      ' <(pacman -Sl || true) -
      ;;
    foreign|drops)
      pacman -Qm | awk '
        ARGIND == 1 { repo[$2] = $1; next }
        {
          r = ($1 in repo) ? repo[$1] : "foreign"
          printf "\033[0;31m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;31m[%s]\033[0m\tdropped\t%s\n", $1, $2, r, r
        }
      ' <(pacman -Sl || true) -
      ;;
    issues)
      {
        pacman -Qm | awk '
          ARGIND == 1 { orphans[$1] = 1; next }
          ARGIND == 2 { repo[$2] = $1; next }
          {
            r = ($1 in repo) ? repo[$1] : "foreign"
            if ($1 in orphans) {
              printf "\033[0;33m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;33m[orphan+dropped]\033[0m \033[0;90m(%s)\033[0m\torphan + dropped\t%s\n", $1, $2, r, r
            } else {
              printf "\033[0;31m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;31m[dropped]\033[0m \033[0;90m(%s)\033[0m\tdropped\t%s\n", $1, $2, r, r
            }
          }
        ' <(pacman -Qdtq || true) <(pacman -Sl || true) -

        pacman -Qdt | awk '
          ARGIND == 1 { seen[$1] = 1; next }
          ARGIND == 2 { repo[$2] = $1; next }
          !($1 in seen) {
            r = ($1 in repo) ? repo[$1] : "foreign"
            printf "\033[0;33m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;33m[orphan]\033[0m \033[0;90m(%s)\033[0m\torphan\t%s\n", $1, $2, r, r
          }
        ' <(pacman -Qmq || true) <(pacman -Sl || true) -
      }
      ;;
    ""|all)
      mode="all"
      pacman -Q | awk '
        ARGIND == 1 { repo[$2] = $1; next }
        {
          r = ($1 in repo) ? repo[$1] : "foreign"
          printf "\033[0;36m%-32s\033[0m \033[0;90m%-18s\033[0m \033[0;90m[%s]\033[0m\tinstalled\t%s\n", $1, $2, r, r
        }
      ' <(pacman -Sl || true) -
      ;;
    *)
      echo "Usage: pacbrowse [all|explicit|orphans|foreign|issues]" >&2
      exit 1
      ;;
  esac | awk -F'\t' '{
    plain = $1
    gsub(/\033\[[0-9;]*m/, "", plain)
    sub(/^[[:space:]]+/, "", plain)
    split(plain, parts, /[[:space:]]+/)
    printf "%s\t%s\n", parts[1], $0
  }' | LC_ALL=C sort -t$'\t' -k1,1 | cut -f2-
}

preview_cmd='
  pkg=$(awk "{print \$1}" <<< {1})
  pkg_status={2}
  pkg_repo={3}

  case "$pkg_status" in
    *dropped*) status_color="\033[1;31m" ;;
    *orphan*)  status_color="\033[1;33m" ;;
    *)         status_color="\033[1;36m" ;;
  esac
  printf "\033[1;32mstatus:\033[0m %b%s\033[0m\n" "$status_color" "$pkg_status"

  printf "\033[1;32mRepo:\033[0m %s" "$pkg_repo"
  git_dir="$HOME/.cache/yay/$pkg/.git"
  if [[ -d "$git_dir" ]]; then
    remote_url=$(git -C "$HOME/.cache/yay/$pkg" remote get-url origin 2>/dev/null || true)
    if [[ "$remote_url" == *"aur.archlinux.org"* ]]; then
      printf " \033[1;35m[AUR: %s]\033[0m" "$remote_url"
    elif [[ -n "$remote_url" ]]; then
      printf " \033[1;90m[Git: %s]\033[0m" "$remote_url"
    fi
  fi
  printf "\n"

  qi_raw=$(pacman -Qi "$pkg")
  install_reason=$(awk -F" : " "/^Install Reason/{sub(/^ : /, \"\", \$2); print \$2}" <<< "$qi_raw")
  required_by=$(awk -F" : " "/^Required By/{sub(/^ : /, \"\", \$2); print \$2}" <<< "$qi_raw")

  printf "\033[1;32mInstall Reason:\033[0m %s\n" "$install_reason"
  printf "\033[1;32mRequired By:\033[0m %s\n\n" "$required_by"

  printf "%s\n" "$qi_raw" | awk -F" : " '\''
    NF >= 2 {
      key = $1
      $1 = ""
      sub(/^ : /, "", $0)
      printf "\033[1;34m%-18s\033[0m : \033[0;37m%s\033[0m\n", key, $0
    }
    NF < 2 { print }
  '\''
'

header_text="Mode: $mode | ^I: info | ^T: tree | ^R: rev-tree | ^X: remove | Esc: exit"

build_entries | fzf \
  --ansi \
  --tac \
  --delimiter=$'\t' \
  --with-nth=1 \
  --preview "$preview_cmd" \
  --preview-window='right:60%:wrap' \
  --header="$header_text" \
  --bind 'ctrl-i:execute(pkg=$(awk "{print \$1}" <<< {1}); pacman -Qi "$pkg" | less -R)' \
  --bind 'ctrl-t:execute(pkg=$(awk "{print \$1}" <<< {1}); if command -v pactree >/dev/null 2>&1; then pactree -c "$pkg" | less -R; else pacman -Qi "$pkg" | less -R; fi)' \
  --bind 'ctrl-r:execute(pkg=$(awk "{print \$1}" <<< {1}); if command -v pactree >/dev/null 2>&1; then pactree -cr "$pkg" | less -R; else pacman -Q --owns "$pkg" 2>/dev/null | less -R; fi)' \
  --bind 'ctrl-x:execute(pkg=$(awk "{print \$1}" <<< {1}); sudo pacman -Rns "$pkg"; read -rp "Press Enter to continue...")'
