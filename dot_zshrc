local _zsh_dir="$HOME/.config/zsh"
local _sources_dir="$_zsh_dir/sources"
local _funcs_dir="$_zsh_dir/functions"

# UTILITIES FUNCTIONS
is_readable() {
    [[ -r "$1" ]]
}

source_if_readable() {
    is_readable "$1" && source "$1"
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

# EXPORTS
source_if_readable "$_zsh_dir/exports.zsh"

# BREW
# CUSTOM_BREW machines set up brew via their own auto-sourced linuxbrew.zsh
if [[ "${CUSTOM_BREW:-}" != "TRUE" ]]; then
    local _brew_path="/home/linuxbrew/.linuxbrew/bin/brew"
    is_readable "$_brew_path" && eval "$($_brew_path shellenv)"
fi

# AUTO LOADING FUNCTIONS
fpath=($_funcs_dir $fpath)
for func in "$_funcs_dir"/*; do
    is_readable "$func" && autoload -Uz "${func:t}"
done

# AUTO SOURCING
for file in "$_sources_dir"/*.zsh; do
    source_if_readable "$file"
done

# ZSH SYNTAX HIGHLIGHTING
source_if_readable /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# FZF key bindings and fuzzy completion
has_command fzf && source <(fzf --zsh)

# ATUIN
has_command atuin && eval "$(atuin init zsh)"

# STARSHIP
has_command starship && eval "$(starship init zsh)"

# MISE
has_command mise && eval "$(mise activate zsh)"

